{
  "name": "rhseung",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "browser": { "binding": "BROWSER" },
  "vars": { "ENVIRONMENT": "production" },
  "r2_buckets": [{ "binding": "ASSET_STORE", "bucket_name": "rhseung-assets" }],
  "kv_namespaces": [{ "binding": "CONTRIBUTIONS", "id": "7637c9df043c46cbb73be39db42b52a3" }],
  "triggers": { "crons": ["17 * * * *"] },
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/api/*", "/resume-*.pdf"]
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "www.rhseung.me", "custom_domain": true },
    { "pattern": "rhseung.me", "custom_domain": true }
  ],
  "env": {
    "staging": {
      "routes": [{ "pattern": "stg.rhseung.me", "custom_domain": true }],
      "browser": { "binding": "BROWSER" },
      "vars": { "ENVIRONMENT": "staging" },
      "r2_buckets": [{ "binding": "ASSET_STORE", "bucket_name": "rhseung-assets" }],
      "kv_namespaces": [{ "binding": "CONTRIBUTIONS", "id": "7637c9df043c46cbb73be39db42b52a3" }],
      "triggers": { "crons": [] }
    }
  }
}
