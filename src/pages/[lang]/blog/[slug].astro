---
import { getCollection, render, type CollectionEntry } from 'astro:content';

import { PostDetailIsland } from '@/pages/_islands/post-detail-island';
import { SITE } from '@/common/lib';
import { toPostSummary } from '@/features/blog';
import { MDX_COMPONENTS } from '@/common/components';
import Layout from '@/layouts/layout.astro';

export async function getStaticPaths() {
  const entries: CollectionEntry<'posts'>[] = await getCollection(
    'posts',
    ({ data }: CollectionEntry<'posts'>) => !data.draft,
  );

  return entries.map((entry) => ({
    params: { lang: entry.data.lang, slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;

const post = toPostSummary(entry);
const { Content } = await render(entry);
---

<Layout
  lang={post.lang}
  title={`${post.title} — ${SITE.title}`}
  description={post.summary}
  type="article"
>
  <PostDetailIsland post={post} client:idle>
    <Content components={MDX_COMPONENTS} />
  </PostDetailIsland>
</Layout>
