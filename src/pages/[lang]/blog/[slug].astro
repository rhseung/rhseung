---
import { mdxComponents } from '@/common/components';
import { PostDetailView } from '@/features/blog';
import { postPaths } from '@/features/blog/paths';
import Layout from '@/layouts/layout.astro';

export const getStaticPaths = postPaths;

const { lang, post, headings, Content } = Astro.props;
---

<Layout
  lang={lang}
  title={post.title}
  description={post.summary}
  type="article"
  published={post.date}
  route={{ to: '/[lang]/blog/[slug]', params: { slug: post.slug } }}
>
  <PostDetailView lang={lang} post={post} headings={headings} client:idle>
    <Content components={mdxComponents(lang)} />
  </PostDetailView>
</Layout>
