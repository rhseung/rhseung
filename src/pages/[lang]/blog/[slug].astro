---
import { getCollection, render, type CollectionEntry } from 'astro:content';

import { PostDetailIsland } from '@/pages/_islands/post-detail-island';
import { SITE } from '@/common/lib';
import { toPostSummary } from '@/features/blog';
import BaseLayout from '@/layouts/base-layout.astro';

/**
 * 글은 번역하지 않는다 — 쓴 언어 접두사 아래에만 존재한다. 한국어 글은 `/ko/blog/<slug>/`
 * 하나뿐이고 `/en/`엔 없다. 그래서 언어 미러도 hreflang도 걸지 않는다.
 */
export async function getStaticPaths() {
  const entries: CollectionEntry<'posts'>[] = await getCollection(
    'posts',
    ({ data }: CollectionEntry<'posts'>) => !data.draft,
  );

  return entries.map((entry) => ({
    params: { lang: entry.data.lang, slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;

const post = toPostSummary(entry);
const { Content } = await render(entry);
---

<BaseLayout
  lang={post.lang}
  title={`${post.title} — ${SITE.title[post.lang]}`}
  description={post.summary}
  type="article"
>
  <PostDetailIsland post={post} client:idle>
    <Content />
  </PostDetailIsland>
</BaseLayout>
