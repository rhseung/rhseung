---
import { BlogView } from '@/features/blog';
import { blogPaths } from '@/features/blog/paths';
import Layout from '@/layouts/layout.astro';

export const getStaticPaths = blogPaths;

const { lang, posts } = Astro.props;
---

<Layout lang={lang} route={{ to: '/[lang]/blog' }}>
  <BlogView lang={lang} posts={posts} />
</Layout>
