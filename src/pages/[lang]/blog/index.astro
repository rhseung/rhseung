---
import { getCollection, type CollectionEntry } from 'astro:content';

import { languagePaths } from '@/common/lib';
import { BlogView, pickBody, publishedPosts, toPostSummary } from '@/features/blog';
import Layout from '@/layouts/layout.astro';

export function getStaticPaths() {
  return languagePaths();
}

const { lang } = Astro.props;

const entries: CollectionEntry<'posts'>[] = await getCollection('posts');
const posts = publishedPosts().map((item) =>
  toPostSummary(item, pickBody(entries, item.slug, lang)),
);
---

<Layout lang={lang} route={{ to: '/[lang]/blog' }}>
  <BlogView lang={lang} posts={posts} />
</Layout>
