---
import { getCollection, type CollectionEntry } from 'astro:content';

import { BlogIsland } from '@/pages/_islands/blog-island';
import { i18n, languagePaths, SITE, localeHref } from '@/common/lib';
import { toPostSummary } from '@/features/blog';
import Layout from '@/layouts/layout.astro';

export function getStaticPaths() {
  return languagePaths();
}

const { lang } = Astro.props;

const entries: CollectionEntry<'posts'>[] = await getCollection(
  'posts',
  ({ data }: CollectionEntry<'posts'>) => !data.draft,
);
const posts = entries.map(toPostSummary);

const t = i18n.getFixedT(lang, 'common');
---

<Layout
  lang={lang}
  title={`${t(($) => $.nav.blog)} — ${SITE.title}`}
  description={t(($) => $.site.description)}
  alternates={{ ko: localeHref('ko', '/blog'), en: localeHref('en', '/blog') }}
>
  <BlogIsland lang={lang} posts={posts} client:load />
</Layout>
