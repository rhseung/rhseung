---
import { PaperContent, PaperView } from '@/features/research';
import { paperPaths } from '@/features/research/paths';
import Layout from '@/layouts/layout.astro';

export const getStaticPaths = paperPaths;

const { lang, item, bibtex, paper } = Astro.props;
---

<Layout
  lang={lang}
  title={item.title}
  description={item.summary}
  type="article"
  route={{ to: '/[lang]/research/[slug]', params: { slug: item.slug } }}
  wip
>
  <PaperView lang={lang} item={item} authors={paper.authors} bibtex={bibtex} client:idle>
    <PaperContent hast={paper.body} lang={lang} />
    {
      paper.bibliography && (
        <PaperContent slot="bibliography" hast={paper.bibliography} lang={lang} />
      )
    }
  </PaperView>
</Layout>
