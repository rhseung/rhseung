---
import { PaperIsland } from '@/pages/_islands/paper-island';
import { LANGUAGES } from '@/common/lib';
import { PAPER_SLUGS, PaperContent, researchOf } from '@/features/research';
import { renderPaper } from '@/features/research/viewmodels/render-paper';
import Layout from '@/layouts/layout.astro';

// 파싱을 여기서 끝낸다. `PaperContent` 는 client 디렉티브가 없어 빌드 때 정적으로 렌더되므로
// unified-latex 와 citation-js 가 클라이언트 번들에 실리지 않는다.
const papers = import.meta.glob('@/content/research/*/paper.tex', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const bibs = import.meta.glob('@/content/research/*/refs.bib', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const slugOf = (path: string) => path.split('/').at(-2);

export function getStaticPaths() {
  return LANGUAGES.flatMap((lang) =>
    [...PAPER_SLUGS].map((slug) => ({ params: { lang, slug }, props: { lang, slug } })),
  );
}

const { lang, slug } = Astro.props;

const item = researchOf(lang).find((entry) => entry.slug === slug);
if (!item) throw new Error(`research 에 ${slug} 가 없습니다`);

const source = Object.entries(papers).find(([path]) => slugOf(path) === slug)?.[1] as string;
const bib = Object.entries(bibs).find(([path]) => slugOf(path) === slug)?.[1] as string | undefined;

const paper = renderPaper(source, bib);
---

<Layout
  lang={lang}
  title={item.title}
  description={item.summary}
  type="article"
  route={{ to: '/[lang]/research/[slug]', params: { slug } }}
>
  <PaperIsland lang={lang} item={item} authors={paper.authors} bibtex={bib} client:idle>
    <PaperContent hast={paper.body} lang={lang} />
    {
      paper.bibliography && (
        <PaperContent slot="bibliography" hast={paper.bibliography} lang={lang} />
      )
    }
  </PaperIsland>
</Layout>
