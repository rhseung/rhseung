---
import { ResearchIsland } from '@/pages/_islands/research-island';
import { i18n, languagePaths } from '@/common/lib';
import { PAPER_SLUGS, researchOf } from '@/features/research';
import Layout from '@/layouts/layout.astro';

export function getStaticPaths() {
  return languagePaths();
}

const { lang } = Astro.props;
---

<Layout
  lang={lang}
  title={i18n.getFixedT(lang, 'common')(($) => $.nav.research)}
  route={{ to: '/[lang]/research' }}
>
  <ResearchIsland lang={lang} items={researchOf(lang)} papers={[...PAPER_SLUGS]} client:load />
</Layout>
