---
import { languagePaths } from '@/common/lib';
import { ResearchView } from '@/features/research';
import Layout from '@/layouts/layout.astro';

export const getStaticPaths = languagePaths;

const { lang } = Astro.props;
---

<Layout lang={lang} route={{ to: '/[lang]/research' }} wip>
  <ResearchView lang={lang} />
</Layout>
