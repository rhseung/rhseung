---
import { ProjectsView } from '@/features/projects';
import { projectsPaths } from '@/features/projects/paths';
import Layout from '@/layouts/layout.astro';

export const getStaticPaths = projectsPaths;

const { lang, projects, awards } = Astro.props;
---

<Layout lang={lang} route={{ to: '/[lang]/projects' }} wip>
  <ProjectsView lang={lang} projects={projects} awards={awards} client:load />
</Layout>
