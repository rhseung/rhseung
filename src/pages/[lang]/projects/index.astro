---
import { getCollection, type CollectionEntry } from 'astro:content';

import { ProjectsIsland } from '@/pages/_islands/projects-island';
import { i18n, languagePaths, SITE, localeHref } from '@/common/lib';
import { projectsOf } from '@/features/projects';
import Layout from '@/layouts/layout.astro';

export function getStaticPaths() {
  return languagePaths();
}

const { lang } = Astro.props;

// 상세 페이지는 그 언어로 MDX 본문이 있는 프로젝트만 갖는다.
const details: CollectionEntry<'projects'>[] = await getCollection('projects');
const detailSlugs = new Set(
  details.filter((entry) => entry.id.endsWith(`/${lang}`)).map((entry) => entry.id.split('/')[0]),
);
---

<Layout
  lang={lang}
  title={`${i18n.getFixedT(lang, 'common')(($) => $.nav.projects)} — ${SITE.title[lang]}`}
  alternates={{ ko: localeHref('ko', '/projects'), en: localeHref('en', '/projects') }}
>
  <ProjectsIsland lang={lang} projects={projectsOf(lang, detailSlugs)} client:load />
</Layout>
