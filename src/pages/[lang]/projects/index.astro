---
import { getCollection, type CollectionEntry } from 'astro:content';

import { ProjectsIsland } from '@/pages/_islands/projects-island';
import { i18n, languagePaths } from '@/common/lib';
import { awardsOf } from '@/features/career';
import { projectsOf } from '@/features/projects';
import Layout from '@/layouts/layout.astro';

export function getStaticPaths() {
  return languagePaths();
}

const { lang } = Astro.props;

const details: CollectionEntry<'projects'>[] = await getCollection('projects');
const detailSlugs = new Set(
  details.filter((entry) => entry.id.endsWith(`/${lang}`)).map((entry) => entry.id.split('/')[0]),
);
---

<Layout
  lang={lang}
  title={i18n.getFixedT(lang, 'common')(($) => $.nav.projects)}
  route={{ to: '/[lang]/projects' }}
>
  <ProjectsIsland
    lang={lang}
    projects={projectsOf(lang, detailSlugs)}
    awards={awardsOf(lang)}
    client:load
  />
</Layout>
