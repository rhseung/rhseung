---
import { getCollection, render, type CollectionEntry } from 'astro:content';

import { ProjectDetailIsland } from '@/pages/_islands/project-detail-island';
import { LANGUAGES, localeHref, SITE } from '@/common/lib';
import { awardsOf } from '@/features/career';
import { projectsOf } from '@/features/projects';
import { MDX_COMPONENTS } from '@/common/components';
import Layout from '@/layouts/layout.astro';

export async function getStaticPaths() {
  const entries: CollectionEntry<'projects'>[] = await getCollection('projects');

  return entries.map((entry) => {
    const [slug, lang] = entry.id.split('/') as [string, (typeof LANGUAGES)[number]];
    const siblings = entries
      .filter((other) => other.id.startsWith(`${slug}/`))
      .map((other) => other.id.split('/')[1]);

    const alternates = Object.fromEntries(
      LANGUAGES.filter((other) => siblings.includes(other)).map((other) => [
        other,
        localeHref(other, `/projects/${slug}`),
      ]),
    );

    return { params: { lang, slug }, props: { lang, slug, entry, alternates } };
  });
}

const { lang, slug, entry, alternates } = Astro.props;

const project = projectsOf(lang, new Set([slug])).find((item) => item.slug === slug);
if (!project) throw new Error(`PROJECTS 에 ${slug} 가 없습니다`);

const linked = new Set(project.awards ?? []);
const awards = awardsOf(lang).filter((award) => linked.has(award.slug));

const { Content } = await render(entry);
const otherLang = lang === 'ko' ? 'en' : 'ko';
---

<Layout
  lang={lang}
  title={`${project.title} — ${SITE.title}`}
  description={project.summary}
  type="article"
  alternates={Object.keys(alternates).length > 1 ? alternates : undefined}
>
  <ProjectDetailIsland
    lang={lang}
    project={project}
    awards={awards}
    altHref={alternates[otherLang]}
    client:idle
  >
    <Content components={MDX_COMPONENTS} />
  </ProjectDetailIsland>
</Layout>
