---
import { mdxComponents } from '@/common/components';
import { ProjectDetailView } from '@/features/projects';
import { projectDetailPaths } from '@/features/projects/paths';
import Layout from '@/layouts/layout.astro';

export const getStaticPaths = projectDetailPaths;

const { lang, slug, available, project, awards, Content } = Astro.props;
---

<Layout
  lang={lang}
  title={project.title}
  description={project.summary}
  type="article"
  route={{ to: '/[lang]/projects/[slug]', params: { slug } }}
  wip
  available={available}
>
  <ProjectDetailView lang={lang} project={project} awards={awards} client:idle>
    <Content components={mdxComponents(lang)} />
  </ProjectDetailView>
</Layout>
