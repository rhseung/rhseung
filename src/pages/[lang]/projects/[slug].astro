---
import { getCollection, render, type CollectionEntry } from 'astro:content';

import { ProjectDetailIsland } from '@/pages/_islands/project-detail-island';
import { LANGUAGES } from '@/common/lib';
import { awardsOf } from '@/features/career';
import { projectsOf } from '@/features/projects';
import { mdxComponents } from '@/common/components';
import Layout from '@/layouts/layout.astro';

export async function getStaticPaths() {
  const entries: CollectionEntry<'projects'>[] = await getCollection('projects');

  return entries.map((entry) => {
    const [slug, lang] = entry.id.split('/') as [string, (typeof LANGUAGES)[number]];
    const siblings = entries
      .filter((other) => other.id.startsWith(`${slug}/`))
      .map((other) => other.id.split('/')[1]);

    const available = LANGUAGES.filter((other) => siblings.includes(other));

    return { params: { lang, slug }, props: { lang, slug, entry, available } };
  });
}

const { lang, slug, entry, available } = Astro.props;

const project = projectsOf(lang, new Set([slug])).find((item) => item.slug === slug);
if (!project) throw new Error(`PROJECTS 에 ${slug} 가 없습니다`);

const linked = new Set(project.awards ?? []);
const awards = awardsOf(lang).filter((award) => linked.has(award.slug));

const { Content } = await render(entry);
---

<Layout
  lang={lang}
  title={project.title}
  description={project.summary}
  type="article"
  route={{ to: '/[lang]/projects/[slug]', params: { slug } }}
  available={available}
>
  <ProjectDetailIsland
    lang={lang}
    project={project}
    awards={awards}
    available={available}
    client:idle
  >
    <Content components={mdxComponents(lang)} />
  </ProjectDetailIsland>
</Layout>
