---
import { getCollection, render, type CollectionEntry } from 'astro:content';

import { ProjectDetailIsland } from '@/pages/_islands/project-detail-island';
import { LANGUAGES, localeHref, SITE } from '@/common/lib';
import { projectsOf } from '@/features/projects';
import BaseLayout from '@/layouts/base-layout.astro';

export async function getStaticPaths() {
  const entries: CollectionEntry<'projects'>[] = await getCollection('projects');

  return entries.map((entry) => {
    const [lang, slug] = entry.id.split('/') as [(typeof LANGUAGES)[number], string];
    const siblings = entries
      .filter((other) => other.id.endsWith(`/${slug}`))
      .map((other) => other.id.split('/')[0]);

    const alternates = Object.fromEntries(
      LANGUAGES.filter((other) => siblings.includes(other)).map((other) => [
        other,
        localeHref(other, `/projects/${slug}`),
      ]),
    );

    return { params: { lang, slug }, props: { lang, slug, entry, alternates } };
  });
}

const { lang, slug, entry, alternates } = Astro.props;

const project = projectsOf(lang, new Set([slug])).find((item) => item.slug === slug);
if (!project) throw new Error(`PROJECTS 에 ${slug} 가 없습니다`);

const { Content } = await render(entry);
const otherLang = lang === 'ko' ? 'en' : 'ko';
---

<BaseLayout
  lang={lang}
  title={`${project.title} — ${SITE.title[lang]}`}
  description={project.summary}
  type="article"
  alternates={Object.keys(alternates).length > 1 ? alternates : undefined}
>
  <ProjectDetailIsland lang={lang} project={project} altHref={alternates[otherLang]} client:idle>
    <Content />
  </ProjectDetailIsland>
</BaseLayout>
