---
import { getCollection, type CollectionEntry } from 'astro:content';

import { CareerIsland } from '@/pages/_islands/resume-islands';
import { i18n, languagePaths, SITE, localeHref } from '@/common/lib';
import { toCareerSummary } from '@/features/resume';
import BaseLayout from '@/layouts/base-layout.astro';

export function getStaticPaths() {
  return languagePaths();
}

const { lang } = Astro.props;

const entries: CollectionEntry<'education'>[] = await getCollection(
  'education',
  ({ id, data }: CollectionEntry<'education'>) => id.startsWith(`${lang}/`) && !data.draft,
);

const t = i18n.getFixedT(lang, 'common');
---

<BaseLayout
  lang={lang}
  title={`${t(($) => $.nav.education)} — ${SITE.title[lang]}`}
  alternates={{ ko: localeHref('ko', '/education'), en: localeHref('en', '/education') }}
>
  <CareerIsland
    lang={lang}
    section="education"
    entries={entries.map(toCareerSummary)}
    client:load
  />
</BaseLayout>
