---
import { CareerIsland } from '@/pages/_islands/resume-islands';
import { i18n, languagePaths, SITE, localeHref } from '@/common/lib';
import { awardsOf, educationOf, experienceOf, skillGroupsOf } from '@/features/career';
import Layout from '@/layouts/layout.astro';

export function getStaticPaths() {
  return languagePaths();
}

const { lang } = Astro.props;
const t = i18n.getFixedT(lang, 'common');
---

<Layout
  lang={lang}
  title={`${t(($) => $.nav.career)} — ${SITE.title}`}
  alternates={{ ko: localeHref('ko', '/[lang]/career'), en: localeHref('en', '/[lang]/career') }}
>
  <CareerIsland
    lang={lang}
    experience={experienceOf(lang)}
    education={educationOf(lang)}
    awards={awardsOf(lang)}
    skills={skillGroupsOf(lang)}
    client:load
  />
</Layout>
