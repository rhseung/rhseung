---
import { CareerView } from '@/features/career';
import { languagePaths } from '@/common/lib';
import Layout from '@/layouts/layout.astro';

export const getStaticPaths = languagePaths;

const { lang } = Astro.props;
---

<Layout lang={lang} route={{ to: '/[lang]/career' }} wip>
  <CareerView lang={lang} />
</Layout>
