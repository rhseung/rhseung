---
import { getCollection, type CollectionEntry } from 'astro:content';

import { ResumeIsland } from '@/pages/_islands/resume-islands';
import { i18n, languagePaths, profileOf, SITE, localeHref } from '@/common/lib';
import { projectsOf, sortProjects } from '@/features/projects';
import { awardsOf, educationOf, experienceOf, skillGroupsOf } from '@/features/career';
import Layout from '@/layouts/layout.astro';

export function getStaticPaths() {
  return languagePaths();
}

const { lang } = Astro.props;

const details: CollectionEntry<'projects'>[] = await getCollection('projects');
const detailSlugs = new Set(
  details.filter((entry) => entry.id.endsWith(`/${lang}`)).map((entry) => entry.id.split('/')[0]),
);

const t = i18n.getFixedT(lang, 'common');
---

<Layout
  lang={lang}
  title={`${t(($) => $.nav.resume)} — ${SITE.title[lang]}`}
  description={profileOf(lang).headline}
  alternates={{ ko: localeHref('ko', '/resume'), en: localeHref('en', '/resume') }}
>
  <ResumeIsland
    lang={lang}
    name={SITE.name[lang]}
    profile={profileOf(lang)}
    experience={experienceOf(lang)}
    education={educationOf(lang)}
    projects={sortProjects(projectsOf(lang, detailSlugs), { pinnedFirst: true })}
    awards={awardsOf(lang)}
    skills={skillGroupsOf(lang)}
    resumeHref={`/resume-${lang}.pdf`}
    client:load
  />
</Layout>
