---
import { getCollection, type CollectionEntry } from 'astro:content';

import { ResumeIsland } from '@/pages/_islands/resume-island';
import { i18n, languagePaths } from '@/common/lib';
import { detailSlugs, projectsOf, sortProjects } from '@/features/projects';
import { awardsOf, educationOf, experienceOf, skillGroupsOf } from '@/features/career';
import Layout from '@/layouts/layout.astro';

export function getStaticPaths() {
  return languagePaths();
}

const { lang } = Astro.props;

const details: CollectionEntry<'projects'>[] = await getCollection('projects');
const slugsWithDetail = detailSlugs(details, lang);

const t = i18n.getFixedT(lang, 'resume');
---

<Layout
  lang={lang}
  title={t(($) => $.page.title)}
  description={i18n.getFixedT(lang, 'common')(($) => $.site.description)}
  route={{ to: '/[lang]/resume' }}
  wip
>
  <ResumeIsland
    lang={lang}
    experience={experienceOf(lang)}
    education={educationOf(lang)}
    projects={sortProjects(projectsOf(lang, slugsWithDetail))}
    awards={awardsOf(lang)}
    skills={skillGroupsOf(lang)}
    resumeHref={`/resume-${lang}.pdf`}
    client:load
  />
</Layout>
