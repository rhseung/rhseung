---
import { getCollection, type CollectionEntry } from 'astro:content';

import { i18n, languagePaths } from '@/common/lib';
import { detailSlugs } from '@/features/projects';
import { ResumeView } from '@/features/resume';
import Layout from '@/layouts/layout.astro';

export function getStaticPaths() {
  return languagePaths();
}

const { lang } = Astro.props;

const details: CollectionEntry<'projects'>[] = await getCollection('projects');
---

<Layout
  lang={lang}
  title={i18n.getFixedT(lang, 'resume')(($) => $.page.title)}
  route={{ to: '/[lang]/resume' }}
  wip
>
  <ResumeView lang={lang} detailSlugs={detailSlugs(details, lang)} />
</Layout>
