---
import { execSync } from 'node:child_process';

import { HomeIsland } from '@/pages/_islands/home-island';
import { languagePaths, SITE, localeHref } from '@/common/lib';
import { loadContributionsSnapshot } from '@/features/home';

import Layout from '@/layouts/layout.astro';

export function getStaticPaths() {
  return languagePaths();
}

const { lang } = Astro.props;

const updatedAt = (() => {
  try {
    return execSync('git log -1 --format=%cI').toString().trim();
  } catch {
    return new Date().toISOString();
  }
})();

const snapshot = await loadContributionsSnapshot();
---

<Layout
  lang={lang}
  title={SITE.title}
  alternates={{ ko: localeHref('ko', '/'), en: localeHref('en', '/') }}
>
  <HomeIsland
    lang={lang}
    updatedAt={updatedAt}
    contributions={snapshot.contributions}
    fetchedAt={snapshot.fetchedAt}
    client:load
  />
</Layout>
