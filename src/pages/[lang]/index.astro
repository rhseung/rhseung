---
import { execSync } from 'node:child_process';

import { HomeIsland } from '@/pages/_islands/home-island';
import { languagePaths, SITE } from '@/common/lib';

import Layout from '@/layouts/layout.astro';

export function getStaticPaths() {
  const updatedAt = (() => {
    try {
      return execSync('git log -1 --format=%cs').toString().trim();
    } catch {
      return new Date().toISOString().slice(0, 10);
    }
  })();

  return languagePaths().map((path) => ({ ...path, props: { ...path.props, updatedAt } }));
}

const { lang, updatedAt } = Astro.props;
---

<Layout lang={lang} title={SITE.title} route={{ to: '/[lang]' }}>
  <HomeIsland lang={lang} updatedAt={updatedAt} client:load />
</Layout>
