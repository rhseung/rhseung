---
import { SITE } from '@/common/lib';
import { HomeView } from '@/features/home';
import { homePaths } from '@/features/home/paths';
import Layout from '@/layouts/layout.astro';

export const getStaticPaths = homePaths;

const { lang, updatedOn } = Astro.props;
---

<Layout lang={lang} title={SITE.title} route={{ to: '/[lang]' }}>
  <HomeView lang={lang} updatedOn={updatedOn} client:load />
</Layout>
