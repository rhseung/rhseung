---
import { NotFoundIsland } from '@/common/components';
import { languagePaths } from '@/common/lib';
import Layout from '@/layouts/layout.astro';

export const getStaticPaths = languagePaths;

const { lang } = Astro.props;
---

<Layout lang={lang} title="404">
  <NotFoundIsland lang={lang} client:load />
</Layout>
