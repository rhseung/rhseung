---
import { ClientRouter } from 'astro:transitions';

import themeScript from './theme.js?raw';

import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

import { i18n, SITE, type Language } from '@/common/lib';
import '@/styles.css';

interface Props {
  lang: Language;
  title: string;
  description?: string;
  alternates?: Partial<Record<Language, string>>;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  lang,
  title,
  description = i18n.getFixedT(lang, 'common')(($) => $.site.description),
  alternates,
  image = SITE.ogImage,
  type = 'website',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/icons/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    {
      alternates &&
        Object.entries(alternates).map(([hreflang, href]) => (
          <link rel="alternate" hreflang={hreflang} href={new URL(href, Astro.site)} />
        ))
    }

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    <script is:inline set:html={themeScript} />

    <script>
      import { initViewTransitions } from './view-transitions';

      initViewTransitions();
    </script>

    <ClientRouter />
  </head>
  <body>
    <slot />

    <Analytics />
    <SpeedInsights />
  </body>
</html>
