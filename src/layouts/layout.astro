---
import { ClientRouter } from 'astro:transitions';

import themeScript from './theme.js?raw';

import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

import {
  DEFAULT_LANGUAGE,
  i18n,
  isNoindex,
  LANGUAGE_TAGS,
  LANGUAGES,
  localeHrefOf,
  SITE,
  type Language,
  type LocaleRouteRef,
} from '@/common/lib';
import '@/styles.css';
import '@/panda.css';

interface Props {
  lang: Language;
  title: string;
  description?: string;
  route?: LocaleRouteRef;
  available?: readonly Language[];
  image?: string;
  type?: 'website' | 'article';
  published?: string;
}

const {
  lang,
  title,
  description,
  route,
  available,
  image = SITE.ogImage,
  type = 'website',
  published,
} = Astro.props;

const t = i18n.getFixedT(lang, 'common');

const canonical = new URL(Astro.url.pathname, Astro.site);
const noindex = isNoindex(canonical.pathname);
const ogImage = image ? new URL(image, Astro.site) : undefined;

const summary = description ?? t(($) => $.site.description);

const langs = available ?? LANGUAGES;
const alternates =
  route !== undefined && langs.length > 1
    ? langs.map((other) => [other, localeHrefOf(other, route)] as const)
    : [];

const author = { '@type': 'Person', name: t(($) => $.site.name), url: SITE.url };

const documentTitle = title === SITE.title ? title : `${title} — ${SITE.title}`;

const schema =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description: summary,
        datePublished: published,
        inLanguage: lang,
        mainEntityOfPage: canonical.href,
        image: ogImage?.href,
        author,
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE.title,
        url: SITE.url,
        inLanguage: lang,
        author,
      };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/icons/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

    <title>{documentTitle}</title>
    <meta name="description" content={summary} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    {
      alternates.map(([hreflang, href]) => (
        <link rel="alternate" hreflang={hreflang} href={new URL(href, Astro.site)} />
      ))
    }
    {
      route !== undefined && alternates.length > 0 && langs.includes(DEFAULT_LANGUAGE) && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(localeHrefOf(DEFAULT_LANGUAGE, route), Astro.site)}
        />
      )
    }

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={LANGUAGE_TAGS[lang].replace('-', '_')} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {published && <meta property="article:published_time" content={published} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    {/* `set:html` 은 이스케이프를 안 해서, 제목에 `</script>` 가 들어오면 블록이 끊긴다. */}
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')}
    />

    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    <script is:inline set:html={themeScript} />

    <script>
      import { initViewTransitions } from './view-transitions';

      initViewTransitions();
    </script>

    <ClientRouter />
  </head>
  <body>
    <slot />

    <Analytics />
    <SpeedInsights />
  </body>
</html>
