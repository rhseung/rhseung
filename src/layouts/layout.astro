---
import { ClientRouter } from 'astro:transitions';

import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

import { i18n, SITE, type Language } from '@/common/lib';
import '@/styles.css';

interface Props {
  lang: Language;
  title: string;
  description?: string;
  alternates?: Partial<Record<Language, string>>;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  lang,
  title,
  description = i18n.getFixedT(lang, 'common')(($) => $.site.description),
  alternates,
  image = SITE.ogImage,
  type = 'website',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    {
      /* sizes="32x32"으로 32px 원본을 박아뒀었는데, 레티나(2x/3x)에서는 그 32px에 여유 해상도가
        없어 브라우저가 도로 확대하며 흐려졌다. 크기 힌트 없이 큰 원본을 주면 브라우저가 방문자
        화면의 실제 배율에 맞춰 알아서 다운스케일한다 - 그게 항상 더 선명하다. */
    }
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    {
      alternates &&
        Object.entries(alternates).map(([hreflang, href]) => (
          <link rel="alternate" hreflang={hreflang} href={new URL(href, Astro.site)} />
        ))
    }

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    {
      /*
      테마를 아일랜드 하이드레이션이 정하면 HTML은 그 전에 이미 그려진다 — 다크 선호
      사용자가 흰 화면 플래시를 본다. 블로킹 스크립트가 첫 페인트 전에 클래스를 박는다.
      키 `theme`은 next-themes 기본 `storageKey`와 같아야 한다.
    */
    }
    <script is:inline>
      const applyTheme = () => {
        const stored = localStorage.getItem('theme') ?? 'system';
        const dark =
          stored === 'dark' ||
          (stored === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      };

      applyTheme();

      // 스왑은 `<html>` 을 통째로 갈아끼운다 — 다시 안 칠하면 전환 직후 한 프레임이 밝다.
      document.addEventListener('astro:after-swap', applyTheme);
    </script>

    <ClientRouter />
  </head>
  <body>
    <slot />

    {/* Vercel 밖(로컬·Storybook)에서는 스크립트가 no-op 이라 조건 분기가 필요 없다. */}
    <Analytics />
    <SpeedInsights />
  </body>
</html>
