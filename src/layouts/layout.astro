---
import { ClientRouter } from 'astro:transitions';

import { css } from 'styled-system/css';

import themeScript from './theme.js?raw';

import { SiteDockIsland, WipNoticeIsland } from '@/common/components';
import { pageHead, SITE, type PageHeadInput } from '@/common/lib';
import '@/styles.css';

type Props = PageHeadInput;

const head = pageHead(Astro.props, Astro.url, Astro.site);
---

<!doctype html>
<html lang={head.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/icons/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

    <title>{head.documentTitle}</title>
    <meta name="description" content={head.summary} />
    <link rel="canonical" href={head.canonical} />
    {head.noindex && <meta name="robots" content="noindex" />}

    {
      head.alternates.map(([hreflang, href]) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))
    }
    {head.xDefault && <link rel="alternate" hreflang="x-default" href={head.xDefault} />}

    <meta property="og:type" content={head.type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={head.documentTitle} />
    <meta property="og:description" content={head.summary} />
    <meta property="og:url" content={head.canonical} />
    <meta property="og:locale" content={head.ogLocale} />
    {head.ogImage && <meta property="og:image" content={head.ogImage} />}
    {head.published && <meta property="article:published_time" content={head.published} />}
    <meta name="twitter:card" content={head.ogImage ? 'summary_large_image' : 'summary'} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(head.schema).replaceAll('<', '\\u003c')}
    />

    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    <script is:inline set:html={themeScript} />

    <script>
      import { initViewTransitions } from './view-transitions';

      initViewTransitions();
    </script>

    <ClientRouter />
  </head>
  <body>
    <div class={css({ display: 'contents' })} inert={head.hidden}>
      <slot />
      {
        head.route !== undefined && (
          <SiteDockIsland
            lang={head.lang}
            current={head.section}
            route={head.route}
            available={head.available}
            client:idle
          />
        )
      }
    </div>
    {head.hidden && <WipNoticeIsland lang={head.lang} client:load />}
  </body>
</html>
