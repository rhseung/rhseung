#!/bin/sh
# push 직전에 `bun run verify`를 돌린다. push하면 Vercel이 곧바로 배포하니,
# 코드가 나가기 전 마지막 관문이 여기다 - AGENTS.md가 "PR 전에 verify"라고
# 적어둔 걸 사람이 깜빡해도 여기서 잡는다.
#
# Bun은 `prepare`/`postinstall`을 실행하지 않는다 - 그래서 이 훅은 자동으로 안 걸린다.
# 한 번만: git config core.hooksPath .githooks

echo "pre-push: bun run verify"
bun run verify
