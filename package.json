    "eslint-plugin-react-refresh": "0.5.4",
    "eslint-plugin-storybook": "10.5.7",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.9.0",
    "husky": "^9.1.7",
    "i18next-cli": "1.67.9",
    "jsdom": "30.0.1",
