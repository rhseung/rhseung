    "prettier-plugin-tailwindcss": "0.8.1",
    "react-doctor": "0.9.11",
    "storybook": "10.5.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "private": true,
  "type": "module",
  "engines": {
