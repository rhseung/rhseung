{
  "name": "rhseung",
  "scripts": {
    "build": "bun run gen && astro check && astro build && bun scripts/gen-resume.ts && bun scripts/gen-readme.ts",
    "build-storybook": "storybook build",
    "check": "prettier --write . && eslint . --fix",
    "deploy": "vercel deploy --prod",
    "dev": "astro dev",
    "doctor": "react-doctor --yes --no-telemetry",
    "format": "prettier --check .",
    "gen": "bun run gen:i18n && bun run gen:favicons && panda codegen --silent",
    "gen:i18n": "i18next-cli extract && i18next-cli types",
    "gen:i18n:watch": "i18next-cli extract --watch & i18next-cli types --watch & wait",
    "gen:readme": "bun scripts/gen-readme.ts",
    "gen:resume": "bun scripts/gen-resume.ts",
    "i18n:lint": "i18next-cli lint",
    "i18n:status": "i18next-cli status",
    "i18n:sync": "i18next-cli sync",
    "lint": "eslint .",
    "msw:init": "msw init ./public --save",
    "preview": "astro preview",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test:e2e": "bun run build && playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:watch": "vitest",
    "typecheck": "astro check",
    "ui:add": "bunx --bun shadcn@latest add",
    "verify": "bun run format && bun run lint && bun run typecheck && bun run doctor && bun run test",
    "prepare": "husky",
    "postinstall": "bun run gen",
    "gen:favicons": "bun scripts/gen-favicons.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/react": "6.0.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@base-ui/react": "1.7.0",
    "@citation-js/core": "^0.8.2",
    "@citation-js/plugin-bibtex": "^0.8.2",
    "@citation-js/plugin-csl": "^0.8.2",
    "@heroicons/react": "^2.2.0",
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.101.4",
    "@unified-latex/unified-latex-to-hast": "^1.8.4",
    "@unified-latex/unified-latex-util-parse": "^1.8.4",
    "@unified-latex/unified-latex-util-print-raw": "^1.8.4",
