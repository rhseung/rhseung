    "astro": "7.2.0",
    "astro-typesafe-routes": "5.2.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.21",
    "es-toolkit": "1.50.0",
    "hast-util-to-html": "^9.0.5",
    "i18next": "26.3.6",
    "katex": "^0.16",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "simple-icons": "^16.29.0",
    "tailwind-merge": "3.6.0",
